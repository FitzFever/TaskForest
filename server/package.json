{
  "name": "taskforest-server",
  "version": "1.0.0",
  "description": "TaskForest backend application",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --exec \"node --experimental-specifier-resolution=node src/server.js\"",
    "dev:api": "node src/dev.js",
    "dev:api:debug": "node --trace-warnings src/dev.js",
    "dev:ts": "ts-node-esm src/server.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:deepseek": "node src/tests/deepseekTest.js",
    "test:decomposition": "node src/examples/taskDecompositionTest.js",
    "test:api": "node src/tests/apiTest.js",
    "test:integration": "node src/tests/taskIntegrationTest.js",
    "test:batch": "node src/tests/batchTaskTest.js",
    "test:api:batch": "node src/tests/batchApiTest.js",
    "test:batch:tasks": "node src/tests/batchTaskTest.js",
    "test:text-to-task": "node src/examples/textToTaskTest.js"
  },
  "keywords": [
    "task",
    "management",
    "forest",
    "productivity"
  ],
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "openai": "^4.0.0",
    "prisma": "^5.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
